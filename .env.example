# Copy to .env (or run `make env`). .env is git-ignored and must never be committed.
EPISCOPE_SALT=change-me
# Scale factor used by `make all` (1.0 -> >= 25M encounters). Keep small while developing.
EPISCOPE_SF=0.05
EPISCOPE_SEED=42
# Spark driver memory: 6g fits a 16 GB laptop; lower it on smaller machines.
SPARK_DRIVER_MEMORY=6g
# Set to 0 to switch off the ENG-3 optimisations (broadcast join + AQE) for before/after runs.
EPISCOPE_OPT=1
